[Unit]
Description=PiOS daemon (owns pi coding-agent sessions)
Documentation=https://github.com/earendil-works/pi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/pios-server serve
Restart=always
RestartSec=2
Environment=NODE_ENV=production
# Sessions must outlive the SSH login or terminal that started them.
KillMode=mixed
TimeoutStopSec=10

# The daemon runs the user's agent, so it deliberately has the user's access to
# their own files. This only blocks privilege escalation beyond that.
# No PrivateTmp/Protect*: in a user unit they imply PrivateUsers=yes, which
# shows root-owned files as nobody and breaks tools like ssh that check owners.
NoNewPrivileges=true

[Install]
WantedBy=default.target
