{
  "name": "pios",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm run --aggregate-output \"/^(typecheck|test:packages)$/\"",
    "test:packages": "pnpm -r test",
    "test:browser": "pnpm -F @pios/sandbox test:browser",
    "typecheck": "tsc --noEmit",
    "build:web": "pnpm -F @pios/web build",
    "sandbox": "tsx packages/sandbox/src/cli.ts",
    "sandbox:shot": "tsx packages/sandbox/src/cli.ts shot",
    "spike:rpc": "tsx spikes/rpc-probe.ts",
    "spike:gotchas": "tsx spikes/gotcha-probe.ts",
    "spike:inproc": "tsx spikes/inproc-probe.ts",
    "spike:retry": "tsx spikes/retry-probe.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0"
  }
}
